-- SINGLE WORKER TO PREVENT TELEPORT CONFLICT
task.spawn(function()
    while Running and GUI.Parent do
        if not Busy then
            Busy = true

            local Success, Error = pcall(function()
                local Locations = GetLocations()

                Counter.Text =
                    "Gold Locations: " .. #Locations

                -- Resume smelting when already in the smelter area.
                if LiftRequested then
                    return
                end

                if AutoLift and SmeltAt then
                    local Current = ReadGoldBars()
                    if Current == nil or GoldBeforeSmelt == nil then
                        Status.Text = "Waiting for Gold Bar counter..."
                    elseif Current <= GoldBeforeSmelt then
                        Status.Text = string.format("Waiting Gold Bars: %d > %d", Current, GoldBeforeSmelt)
                        if AutoSmelter and os.clock() - LastSmelt >= 8 then
                            LastSmelt = os.clock()
                            SmeltGold()
                        end
                    elseif os.clock() - LastLift >= 3 then
                        Status.Text = string.format("Gold Bars: %d -> %d", GoldBeforeSmelt, Current)
                        LastLift = os.clock()
                        ReturnLift()
                    end
                    return
                end

                local Smelter = AutoSmelter and FindSmelting()
                local Root = GetRoot()
                local SmelterPosition = Smelter and GetPosition(Smelter)
                local NearSmelter = Root and SmelterPosition and (Root.Position - SmelterPosition).Magnitude <= 30
                if Smelter and (Completed or PortalActivated or NearSmelter or not FindScanner()) then
                    if os.clock() - LastSmelt >= SMELT_DELAY then
                        LastSmelt = os.clock()
                        SmeltGold()
                    end
                    return
                end

                if Completed and AutoPortal and not PortalActivated then
                    if os.clock() - LastPortal >= 3 then
                        LastPortal = os.clock()
                        ReturnPortal()
                    end
                    return
                end

                if AutoSmelter and (Completed or (not AutoScan and not AutoGet)) then
                    if os.clock() - LastSmelt >= SMELT_DELAY then
                        LastSmelt = os.clock()
                        SmeltGold()
                    end
                    return
                end

                if not Completed and AutoGet and #Locations > 0 then
                    CollectGold()
                    return
                end

                if not Completed and AutoScan and #Locations == 0
                    and os.clock() - LastScan >= SCAN_DELAY then
                    LastScan = os.clock()
                    ScanGold()
                    return
                end

                if not Completed
                    and not AutoScan
                    and not AutoGet
                    and not AutoSmelter then

                    Status.Text = "Status: Standby"
                end
            end)

            Busy = false

            if not Success then
                warn("[OREO HUB V15]", Error)
                Status.Text = "Retrying..."
                task.wait(2)
            end
        end

        task.wait(0.25)
    end
end)

