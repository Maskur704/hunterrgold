-- CHARACTER
local function GetRoot()
    local Character = Player.Character
    if not Character then return end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

-- PROMPT POSITION
local function GetPosition(Prompt)
    local Parent = Prompt and Prompt.Parent
    if not Parent then return end

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition

    elseif Parent:IsA("BasePart") then
        return Parent.Position

    elseif Parent:IsA("Model") then
        return Parent:GetPivot().Position
    end
end

-- TELEPORT SYSTEM
local function Teleport(Position)
    local Root = GetRoot()

    if not Root or not Position or not Running then
        return false
    end

    Root.CFrame = CFrame.new(
        Position + Vector3.new(0, 3, 0)
    )

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    return true
end

-- FIND PROMPT
local function FindPrompt(Filter, MaxDistance)
    local Root = GetRoot()
    if not Root then return end

    local Nearest
    local Distance = MaxDistance or math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.Enabled
            and Filter(Object) then

            local Position = GetPosition(Object)

            if Position then
                local Magnitude =
                    (Root.Position - Position).Magnitude

                if Magnitude < Distance then
                    Distance = Magnitude
                    Nearest = Object
                end
            end
        end
    end

    return Nearest
end

-- FIND SCANNER
local function FindScanner()
    return FindPrompt(function(Object)
        return Object.Name == "@SCAN_PROMPT"
            or Object.ActionText:lower() == "scan for gold ore"
    end)
end

-- FIND DIG
local function FindDig()
    return FindPrompt(function(Object)
        return Object.ActionText:lower() == "dig"
            and Object.ObjectText == "WGC Gold Hunters"
    end, 15)
end

-- FIND PORTAL
local function FindPortal()
    return FindPrompt(function(Object)
        local Action = Object.ActionText:lower()
        local Name = Object.ObjectText:lower()

        return Action:find("teleport", 1, true)
            and (
                Name:find("pemburu emas 2.0", 1, true)
                or Name:find("gold hunters 2.0", 1, true)
            )
    end)
end

-- EXACT SMELTER PATH
local function FindSmelting()
    local Interactable =
        workspace:FindFirstChild("Interactable")

    if not Interactable then return end

    local Smelter =
        Interactable:FindFirstChild("Smelter")

    if not Smelter then return end

    local Attachment =
        Smelter:FindFirstChild("Attachment")

    if not Attachment then return end

    local Prompt =
        Attachment:FindFirstChild("@PROMPT")

    if Prompt
        and Prompt:IsA("ProximityPrompt")
        and Prompt.Enabled
        and Prompt.ActionText:lower() == "smelt" then

        return Prompt
    end

    return nil
end

-- GOLD LOCATIONS
local function GetLocations()
    local Locations = {}

    for _, Object in ipairs(workspace:GetChildren()) do
        if Object:IsA("Model")
            and Object.Name == "Location Beam"
            and not Visited[Object] then

            table.insert(Locations, Object)
        end
    end

    return Locations
end

-- NEAREST GOLD
local function GetNearestGold()
    local Root = GetRoot()
    if not Root then return end

    local Nearest
    local Distance = math.huge

    for _, Gold in ipairs(GetLocations()) do
        local Magnitude =
            (Root.Position - Gold:GetPivot().Position).Magnitude

        if Magnitude < Distance then
            Distance = Magnitude
            Nearest = Gold
        end
    end

    return Nearest
end

-- AUTO INTERACT
local function Activate(Prompt)
    if not Running
        or not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled then

        return false
    end

    if type(fireproximityprompt) ~= "function" then
        Status.Text = "Executor unsupported"
        return false
    end

    local Success, Error = pcall(function()
        fireproximityprompt(Prompt)
    end)

    if not Success then
        warn("[OREO INTERACT]", Error)
    end

    return Success
end

-- AUTO TELEPORT PORTAL
local function ReturnPortal()
    if not Running or not AutoPortal then
        return false
    end

    local Portal = FindPortal()

    if not Portal then
        Status.Text = "Portal not found"
        return false
    end

    Status.Text = "Teleporting to portal..."

    if not Teleport(GetPosition(Portal)) then
        return false
    end

    task.wait(PORTAL_DELAY)

    if not Running or not AutoPortal then
        return false
    end

    if not Portal.Parent or not Portal.Enabled then
        return false
    end

    Status.Text = "Activating portal..."

    if Activate(Portal) then
        PortalActivated = true
        Status.Text = "Portal requested"

        print("[OREO HUB] PORTAL REQUESTED")

        task.wait(2)
        return true
    end

    return false
end

-- Read the exact HUD counter, without guessing a missing value.
local function ReadGoldBars()
    local Node = PlayerGui
    for _, Name in ipairs({"HUD", "GoldCounters", "GoldBarCounter", "Counter"}) do
        Node = Node:FindFirstChild(Name)
        if not Node then return nil end
    end
    if not (Node:IsA("TextLabel") or Node:IsA("TextButton")) then return nil end
    return tonumber((Node.Text:gsub("[, %s]", "")))
end

-- AUTO TELEPORT SMELTER + AUTO E
local function SmeltGold()
    if not Running or not AutoSmelter then
        return
    end

    local Prompt = FindSmelting()

    if not Prompt then
        Status.Text = "Waiting for Smelter..."
        return
    end

    local Root = GetRoot()
    local Position = GetPosition(Prompt)

    if not Root or not Position then
        return
    end

    local Distance =
        (Root.Position - Position).Magnitude

    if Distance > 5 then
        Status.Text = "Teleporting to Smelter..."

        if not Teleport(Position) then
            return
        end

        task.wait(1)
    end

    if not Running or not AutoSmelter then
        return
    end

    Prompt = FindSmelting()
    Root = GetRoot()

    if not Prompt or not Root then
        return
    end

    Position = GetPosition(Prompt)

    if not Position
        or (Root.Position - Position).Magnitude
            > Prompt.MaxActivationDistance then

        Status.Text = "Smelter out of range"
        return
    end

    local Before = ReadGoldBars()
    if Before == nil then
        Status.Text = "Waiting for Gold Bar counter..."
        warn("[OREO V15] Gold bar counter missing or not numeric")
        return
    end
    Status.Text = "Activating Peleburan..."

    if Activate(Prompt) then
        if not SmeltAt then
            GoldBeforeSmelt = Before
            SmeltAt = os.clock()
        end
        Status.Text = "Smelt requested"
        Status.TextColor3 = Color3.fromRGB(80, 255, 120)

        print("[OREO HUB] AUTO E SMELTER REQUESTED")
    else
        Status.Text = "Smelt failed"
    end
end

-- AUTO LIFT: exact object and action, not ambiguous path
local function ReturnLift()
    local Prompt = FindPrompt(function(Object)
        return Object.Name == "PROMPT"
            and Object.ActionText == "Teleport"
            and Object.ObjectText == "Lift"
            and Object:IsDescendantOf(workspace:FindFirstChild("Interactable") or workspace)
    end)
    if not Prompt then Status.Text = "Lift not found"; return end
    Status.Text = "Teleporting to Lift..."
    if not Teleport(GetPosition(Prompt)) then return end
    task.wait(PORTAL_DELAY)
    if not Running or not AutoLift or not Prompt.Parent or not Prompt.Enabled then return end
    local Root, Position = GetRoot(), GetPosition(Prompt)
    if not Root or not Position or (Root.Position - Position).Magnitude > Prompt.MaxActivationDistance then
        Status.Text = "Lift out of range"
        return
    end
    if Activate(Prompt) then
        LiftRequested = true
        Status.Text = "Lift requested"
        print("[OREO V15] LIFT REQUESTED")
    end
end

-- AUTO STOP 10 DIG
local function Finish()
    if Completed then return end

    Completed = true
    AutoScan = false
    AutoGet = false

    UpdateToggle()
    UpdateProgress()

    Status.Text = "10/10 | Completed"
end

-- AUTO SCAN GOLD
local function ScanGold()
    if Completed then return end

    local Scanner = FindScanner()

    if not Scanner then
        Status.Text = "Scanner not found"
        return
    end

    Status.Text = "Scanning gold..."

    if Teleport(GetPosition(Scanner)) then
        task.wait(0.7)

        if AutoScan and Running and not Completed then
            Activate(Scanner)
            task.wait(SCAN_DELAY)
        end
    end
end

-- AUTO GET GOLD
local function CollectGold()
    if Progress >= LIMIT then
        Finish()
        return
    end

    local Gold = GetNearestGold()
    if not Gold then return end

    Status.Text = "Moving to gold..."

    if not Teleport(Gold:GetPivot().Position) then
        return
    end

    local Prompt

    for Attempt = 1, 20 do
        if not Running or not AutoGet or Completed then
            return
        end

        Prompt = FindDig()

        if Prompt then break end

        task.wait(0.25)
    end

    if not Prompt then
        Visited[Gold] = true
        Status.Text = "Dig prompt not found"
        return
    end

    Status.Text = "Digging gold..."

    if not Teleport(GetPosition(Prompt)) then
        return
    end

    task.wait(0.5)

    if not Running or not AutoGet or Completed then
        return
    end

    if Activate(Prompt) then
        Progress = math.min(Progress + 1, LIMIT)
        Visited[Gold] = true

        UpdateProgress()

        if Progress >= LIMIT then
            Finish()
            return
        end

        task.wait(DIG_DELAY)
    end
end

